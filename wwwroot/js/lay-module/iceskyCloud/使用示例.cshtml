                <button type="button" class="layui-btn" id="btnClear">清空</button>
                <button type="button" class="layui-btn" id="btnRead">读出 formData</button>
                <button type="button" class="layui-btn" id="btnLockTitle">禁用标题</button>
                <button type="button" class="layui-btn" id="btnLockType">禁用类型</button>
                <button type="button" class="layui-btn" id="btnLockUser">禁用参照</button>
                <button type="button" class="layui-btn" id="btnLockImage">禁用图片</button>
                <button type="button" class="layui-btn" id="btnUnlockForm">解开表单禁用</button>
                <button type="button" class="layui-btn" id="btnRequireTitle">标题必填</button>
                <button type="button" class="layui-btn" id="btnUnrequireTitle">取消标题必填</button>
            </div>
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="form-fields"></div>
                <div class="layui-tabform-item text-right">
                    <button class="layui-btn" lay-submit id="submit" lay-filter="saveBtn">看提交数据</button>
                </div>
            </div>
            <div class="demo-json">
                <div class="demo-json-title">实时 formData（控件里改，这里也会变）</div>
                <pre id="formJson">{}</pre>
            </div>
        </div>
        <div class="demo-hero" style="margin-top: 28px;">
            <h2>commonTable 可编辑表示例</h2>
            <p>点格子改 input / 日期 / 下拉 / 参照 / 备注 / 图片。上方表头「类型」选「已完成」会锁住数量列。禁用 / 必填：tableMap.字段名.update({ disabled: true, required: true })。</p>
        </div>
        <div class="demo-card">
            <div class="demo-actions">
                <button type="button" class="layui-btn layui-btn-normal" id="btnTableCol">整列赋值（数量/日期/类型/参照/树表/图片）</button>
                <button type="button" class="layui-btn" id="btnTableRow">第一行一起赋值</button>
                <button type="button" class="layui-btn" id="btnLockCol">禁用数量列</button>
                <button type="button" class="layui-btn" id="btnLockRow">禁用第一行</button>
                <button type="button" class="layui-btn" id="btnLockCell">禁用第一行数量格</button>
                <button type="button" class="layui-btn" id="btnUnlockAll">解开禁用</button>
                <button type="button" class="layui-btn" id="btnRequireCol">数量列必填</button>
                <button type="button" class="layui-btn" id="btnRequireRow">第一行必填</button>
                <button type="button" class="layui-btn" id="btnRequireCell">第一行数量必填</button>
                <button type="button" class="layui-btn" id="btnUnrequireAll">取消必填</button>
                <button type="button" class="layui-btn" id="btnTableTitle">只改标题</button>
                <button type="button" class="layui-btn" id="btnTableQty">只改数量</button>
                <button type="button" class="layui-btn" id="btnTableDate">只改日期</button>
                <button type="button" class="layui-btn" id="btnTableDateTime">只改日期时间</button>
                <button type="button" class="layui-btn" id="btnTableType">只改类型</button>
                <button type="button" class="layui-btn" id="btnTableTags">只改多选</button>
                <button type="button" class="layui-btn" id="btnTableUser">只改参照</button>
                <button type="button" class="layui-btn" id="btnTableTree">只改树表</button>
                <button type="button" class="layui-btn" id="btnTableImage">只改图片</button>
                <button type="button" class="layui-btn" id="btnTableRemark">只改备注</button>
                <button type="button" class="layui-btn" id="btnTableRead">读出整列 getValue</button>
            </div>
            <table class="layui-hide" id="demoEditTable" lay-filter="demoTableFilter"></table>
            <div class="demo-json">
                <div class="demo-json-title">实时 table.cache（格子里改，这里也会变）</div>
                <pre id="tableJson">[]</pre>
