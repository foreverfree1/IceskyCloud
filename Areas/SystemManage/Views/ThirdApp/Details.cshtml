@{
    ViewBag.Title = "Details"; 
    Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    layui.use(['jquery', 'form', 'laydate', 'common'], function () {
        var form = layui.form,
            $ = layui.$,
            common = layui.common,
            laydate = layui.laydate;
        var keyValue = $.request("keyValue");
        //权限字段
        common.authorizeFields('adminform');

        $(function () {
            initControl();
            common.ajax({
                url: '/SystemManage/ThirdApp/GetFormJson',
                dataType: 'json',
                data: { keyValue: keyValue },
                async: false,
                success: function (data) {
                    common.val('adminform', data);
                    common.setReadOnly('adminform');
                    form.render();
                 }
            });
       });
       wcLoading.close();

       function initControl() {

       }
   });
</script>

<body>
    <div class="layuimini-container">
        <div class="layuimini-main">
            <div class="layui-form layuimini-form" lay-filter="adminform">
                <div class="layui-form-item layui-hide">
                   <label class="layui-form-label required">应用名称</label>
                   <div class="layui-input-block">
                        <input type="text" id="F_AppName" name="F_AppName" autocomplete="off" lay-verify="required" placeholder="请输入" class="layui-input">
                   </div>
               </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label required">应用标识</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_AppId" name="F_AppId" lay-verify="required" readonly disabled class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label required">应用密钥</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_AppSecret" name="F_AppSecret" lay-verify="required" readonly disabled class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label required">最新版本</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_AppVersion" name="F_AppVersion" lay-verify="required"
                            class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label">安装包</label>
                    <div class="layui-input-block" style="display: flex;">
                        <input type="text" id="F_StartPackage" name="F_StartPackage"
                            class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label">更新包</label>
                    <div class="layui-input-block" style="display: flex;">
                        <input type="text" id="F_UpdatePackage" name="F_UpdatePackage"
                            class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                    <label class="layui-form-label">更新说明</label>
                    <div class="layui-input-block">
                        <input type="text" id="F_UpdateNotes" name="F_UpdateNotes" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item layui-hide">
                   <label class="layui-form-label">描述</label>
                   <div class="layui-input-block">
                        <textarea id="F_Description" name="F_Description" value="" autocomplete="off" class="layui-textarea"></textarea>
                   </div>
               </div>
            </div>
        </div>
    </div>
</body>

