@{
ViewBag.Title = "Index";
Layout = "~/Views/Shared/_Index.cshtml";
}
<script>
    layui.use(['form', 'table', 'common', 'commonTable', 'optimizeSelectOption'], function () {
        var form = layui.form,
            table = layui.table,
            commonTable = layui.commonTable,
            common = layui.common;
        //加载数据
        wcLoading.close();
        //权限控制(js是值传递)
        currentTableBar.innerHTML = common.authorizeButtonNew(currentTableBar.innerHTML);
        toolbarDemo.innerHTML = common.authorizeButtonNew(toolbarDemo.innerHTML);
        $("#dbNumber").bindSelect({
            url: "/SystemManage/CodeGenerator/GetDbNumberListJson",
            checked: 0,
            id: ""
        });
        form.render();
        commonTable.rendertable({
            elem: '#currentTableId',
            url: '/SystemManage/CodeGenerator/GetTablePageListJson',
            cols: [[
                { type: "radio", width: 50, fixed: 'left' },
                { field: 'F_ObjectName', filter: true, title: '对象名称', width: 'auto' },
                { field: 'F_ObjectType', filter: true, title: '对象类型', minWidth: 150 },
                { field: 'F_ObjectDescription', filter: true, title: '对象备注', minWidth: 250 },
                { title: '操作', width: 350, toolbar: '#currentTableBar', align: "center", fixed: 'right' }
            ]]
        });
        var dbNumber = $('#dbNumber').val();
        // 监听搜索操作
        form.on('submit(data-search-btn)', function (data) {
            //执行搜索重载
            commonTable.reloadtable({
                elem: 'currentTableId',
                curr: 1,
                where: { keyword: data.field.txt_keyword, dbNumber: data.field.dbNumber }
            });
            dbNumber = data.field.dbNumber;
            return false;
        });
        //行点击事件监听，控制按钮显示
        var oneList = ["NF-entitycode", "NF-add", "NF-details", "NF-relation", "NF-clearcache"];//选择1条显示
        commonTable.tableRowClick("radio", "currentTableFilter", "currentTableId", oneList);
        /**
         * toolbar监听事件
         */
        table.on('toolbar(currentTableFilter)', function (obj) {
            var data = table.checkStatus('currentTableId').data;
            if (obj.event === 'add') {  // 监听删除操作
                if (data.length == 0) {
                    common.modalMsg("未选中数据", "warning");
                    return false;
                }
                common.openNewTabByIframe({
                    title: "模板代码生成",
                    href: "/SystemManage/CodeGenerator/Form?keyValue=" + data[0].F_ObjectName + "&dbNumber=" + dbNumber,
                });
            }
            else if (obj.event === 'entitycode') {
                if (data.length == 0) {
                    common.modalMsg("未选中数据", "warning");
                    return false;
                }
                common.modalOpen({
                    title: "实体类生成",
                    url: "/SystemManage/CodeGenerator/EntityCode?keyValue=" + data[0].F_ObjectName + "&dbNumber=" + dbNumber,
                    width: "800px",
                    height: "600px",
                });
            }
            else if (obj.event === 'details') {
                if (data.length == 0) {
                    common.modalMsg("未选中数据", "warning");
                    return false;
                }
                common.modalOpen({
                    title: "查看表结构",
                    url: "/SystemManage/CodeGenerator/Details?keyValue=" + data[0].F_ObjectName + "&dbNumber=" + dbNumber,
                    type:'2'
                })
            }
            else if (obj.event === 'relation') {
                if (data.length == 0) {
                    common.modalMsg("未选中数据", "warning");
                    return false;
                }
                common.modalOpen({
                    title: "查看表关系",
                    url: "/SystemManage/CodeGenerator/Relation?keyValue=" + data[0].F_ObjectName + "&dbNumber=" + dbNumber,
                    type:'2'
                })
            }
            else if (obj.event === 'clearcache') {
                if (data.length == 0) {
                    common.modalMsg("未选中数据", "warning");
                    return false;
                }
                common.ajax({
                    type: "Post",
                    async: false,
                    url: '/SystemManage/CodeGenerator/ClearCache?tableName=' + data[0].F_ObjectName,
                    success: function (result) {
                        if (result.state == 'error') {
                            layer.msg(result.message, { icon: 0 })
                        } else {
                            layer.msg("清除缓存成功", { icon: 1 })
                        }
                    }
                })
            }
            else if (obj.event === 'TABLE_SEARCH') {
                var _that = $("#searchField");
                if (_that.hasClass("layui-hide")) {
                    _that.removeClass('layui-hide');
                } else {
                    _that.addClass('layui-hide');
                }
                table.resize();
            }
            return false;
        });
        //toolrow监听事件
        table.on('tool(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {  // 监听
                common.openNewTabByIframe({
                    title: "模板代码生成",
                    href: "/SystemManage/CodeGenerator/Form?keyValue=" + obj.data.F_ObjectName + "&dbNumber=" + dbNumber,
                });
            }
            else if (obj.event === 'entitycode') {
                common.modalOpen({
                    title: "实体类生成",
                    url: "/SystemManage/CodeGenerator/EntityCode?keyValue=" + obj.data.F_ObjectName + "&dbNumber=" + dbNumber,
                    width: "800px",
                    height: "600px",
                });
            }
            else if (obj.event === 'details') {
                common.modalOpen({
                    title: "查看表结构",
                    url: "/SystemManage/CodeGenerator/Details?keyValue=" + obj.data.F_ObjectName + "&dbNumber=" + dbNumber,
                    type:'2'
                })
            }
            else if (obj.event === 'relation') {
                common.modalOpen({
                    title: "查看表关系",
                    url: "/SystemManage/CodeGenerator/Relation?keyValue=" + obj.data.F_ObjectName + "&dbNumber=" + dbNumber,
                    type:'2'
                })
            }
            else if (obj.event === 'clearcache') {
                common.ajax({
                    type: "Post",
                    async: false,
                    url: '/SystemManage/CodeGenerator/ClearCache?tableName=' + obj.data.F_ObjectName,
                    success: function (result) {
                        if (result.state == 'error') {
                            layer.msg(result.message, { icon: 0 })
                        } else {
                            layer.msg("清除缓存成功", { icon: 1 })
                        }
                    }
                })
            }
            return false;
        });
    });
</script>
<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset layui-hide" id="searchField">
            @*<legend>搜索信息</legend>*@
            <div>
                <form class="layui-form layui-form-pane" action="">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">表名称:</label>
                            <div class="layui-input-inline">
                                <input type="text" id="txt_keyword" name="txt_keyword" autocomplete="off"
                                    class="layui-input" placeholder="">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">数据库编号:</label>
                            <div class="layui-input-inline">
                                <select id="dbNumber" name="dbNumber" lay-verify="required" lay-search>
                                </select>
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit
                                lay-filter="data-search-btn">
                                <i class="layui-icon">&#xe615;</i> 搜 索
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>

        <script type="text/html" id="toolbarDemo">
                    <div class="layui-btn-container" id="toolbar">
                            <button id="NF-add" name="NF-add" authorize="yes" class="layui-btn layui-btn-sm layui-hide" lay-event="add"><i class="layui-icon">&#xe654;</i>模板生成</button>
                            <button id="NF-entitycode" name="NF-entitycode" authorize="yes" class="layui-btn layui-btn-sm layui-btn-danger layui-hide" lay-event="entitycode"><i class="layui-icon">&#xe67a;</i>实体生成</button>
                            <button id="NF-clearcache" name="NF-clearcache" authorize="yes" class="layui-btn layui-btn-sm layui-hide" lay-event="clearcache"><i class="layui-icon">&#xe67a;</i>清理缓存</button>
                            <button id="NF-details" name="NF-details" authorize="yes" class="layui-btn layui-btn-sm layui-btn-normal layui-hide" lay-event="details"> <i class="layui-icon">&#xe60b;</i>查看</button>
                            <button id="NF-relation" name="NF-relation" authorize="yes" class="layui-btn layui-btn-sm layui-btn-warm layui-hide" lay-event="relation"><i class="layui-icon">&#xe60b;</i>关系</button>
                    </div>
        </script>
        <script type="text/html" id="currentTableBar">
             {{# if(d.F_ObjectType=="TABLE"||d.F_ObjectType=="VIEW") { }}
                    <a id="NF-add" authorize class="layui-btn layui-btn-xs" lay-event="add">模板生成</a>
                    <a id="NF-entitycode" authorize class="layui-btn layui-btn-xs layui-btn-danger" lay-event="entitycode">实体生成</a>
                    <a id="NF-clearcache" authorize class="layui-btn layui-btn-xs" lay-event="clearcache">清理缓存</a>
            {{# } }}
            <a id="NF-details" authorize class="layui-btn layui-btn-xs layui-btn-normal" lay-event="details">查看</a>
            <a id="NF-relation" authorize class="layui-btn layui-btn-xs layui-btn-warm" lay-event="relation">关系</a>
        </script>
        <table class="layui-hide" id="currentTableId" lay-filter="currentTableFilter"></table>

    </div>
</div>