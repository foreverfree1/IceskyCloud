            if (data.elem.checked) {
                // $('#ishead').prop('checked', false);
                // $('#isheadupdate').prop('checked', false);
                // $('#isheadedit').prop('checked', false);
                // $('#isheadaddverify').prop('checked', false);
                // $("#isheadedit").attr("disabled", "disabled")
                // $("#isheadaddverify").attr("disabled", "disabled")
                // $('#isheadupdateedit').prop('checked', false);
                // $('#isheadupdateverify').prop('checked', false);
                // $("#isheadupdateedit").attr("disabled", "disabled")
                // $("#isheadupdateverify").attr("disabled", "disabled")
                $("#islistedit").removeAttr("disabled")
