@{
ViewBag.Title = "Form";
Layout = "~/Views/Shared/_Form.cshtml";
}
<script>
    var currentModule = '';
    var hasMergeField = false;
    //当前字段是否挂在模块主表（tableid == F_MainTable）下
    var isMainTableField = false;
    var recross = "";//重命名后的字段
    layui.use(['jquery', 'form', 'laydate', 'common', 'optimizeSelectOption', 'tableSelect'], function () {
        var form = layui.form,
            $ = layui.$,
            common = layui.common,
            tableSelect = layui.tableSelect,
            laydate = layui.laydate;
        var keyValue = $.request("keyValue");
        var moduleId = $.request("moduleId");
        var tableid = $.request("tableid");
        var F_Id = "";
        //权限字段
        common.authorizeFields('adminform');
        $(function () {
            $("#datatype").bindSelect({
                url: "/SystemManage/ItemsData/GetSelectJson?enCode=DataType",
                id: "text",
                text: "text"
            });
            common.ajax({
                url: '/SystemManage/Module/GetTreeGridJson',
                dataType: 'json',
                async: false,
                success: function (res) {
                    if (res.data) {
                        var list = res.data.filter(item => item.F_IsExpand == false);
                        $("#modulename").bindSelect({
                            data: list,
                            id: "F_EnCode",
                            text: "F_FullName"
                        });
                    }
                }
            });
            common.ajax({
                url: '/SystemManage/Module/GetFormJson?keyValue=' + moduleId,
                dataType: 'json',
                async: false,
                success: function (result) {
                    if (result) {
                        currentModule = result.F_Id;
                        //tableid 等于模块主表时标记为主表字段（F_MainTable 防逗号分隔，逐个比对）
                        isMainTableField = String(result.F_MainTable || '').split(',').some(function (s) {
                            return $.trim(s).toLowerCase() === String(tableid || '').trim().toLowerCase();
                        });
                    }
                }
            });
            //判断该tableid下字段是否存在合并
            common.ajax({
                url: '/SystemManage/ModuleFields/GetColsJson?tablename=' + tableid,
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        // 判断 data 中是否存在 F_IsMerge 为 true 的项
                        hasMergeField = data.some(item => item.F_IsMerge === true);
                        if (hasMergeField) {
                            $('#subtotal').removeAttr('disabled');
                        }
                    }
                }
            });
            if (!!keyValue) {
                $("#F_EnCode").prop("disabled", true);
                $("#btn_SysTable").prop("disabled", true).addClass("layui-btn-disabled");
                common.ajax({
                    url: '/SystemManage/ModuleFields/GetTableFormJson',
                    dataType: 'json',
                    data: { encode: keyValue, tablename: tableid },
                    async: false,
                    success: function (data) {
                        var model = JSON.parse(data.F_Template);
                        for (var key in model) {
                            if (model.hasOwnProperty(key)) {
                                data[key] = model[key];
                            }
                        }
                        $(`#formwidth`).val(data.formwidth || "0").trigger('change');
                        $(`#align`).val(data.align || "");
                        $(`#fixed`).val(data.fixed || "");
                        $('#placeholder').val(data.placeholder || "");
                        // $(`# F_ReferType`).val(data. F_ReferType);
                        $("#F_IsPublic").prop("checked", !!data.F_IsPublic);
                        $("#F_IsTotal").prop("checked", !!data.F_IsTotal);
                        $("#F_IsMerge").prop("checked", !!data.F_IsMerge);
                        $("#F_EnabledMark").prop("checked", !!data.F_EnabledMark);
                        $("#order").prop("checked", !!data.order);
                        $("#subtotal").prop("checked", !!data.subtotal);
                        subtotal
                        $("#filter").prop("checked", !!data.filter);
                        $("#ignore").prop("checked", !!data.ignore);
                        $("#ishead").prop("checked", !!data.ishead);
                        $("#isheadedit").prop("checked", !!data.isheadedit);
                        $("#isheadaddverify").prop("checked", !!data.isheadaddverify);
                        $("#isheadupdate").prop("checked", !!data.isheadupdate);
                        $("#isheadupdateedit").prop("checked", !!data.isheadupdateedit);
                        $("#isheadupdateverify").prop("checked", !!data.isheadupdateverify);
                        $("#islist").prop("checked", !!data.islist);
                        $("#islistedit").prop("checked", data.islistedit !== false);
                        $("#islistaddverify").prop("checked", !!data.islistaddverify);
                        $("#islistupdate").prop("checked", !!data.islistupdate);
                        $("#islistupdateedit").prop("checked", !!data.islistupdateedit);
                        $("#islistupdateverify").prop("checked", !!data.islistupdateverify);

                        if (data.ishead) {
                            // $("#islistedit").attr("disabled", "disabled")
                            // $("#islistaddverify").attr("disabled", "disabled")
                            // $("#islistupdateedit").attr("disabled", "disabled")
                            // $("#islistupdateverify").attr("disabled", "disabled")
                            $("#isheadedit").removeAttr("disabled")
                            $("#isheadaddverify").removeAttr("disabled")
                        }
                        else {
                            $('#isheadedit').prop('checked', false);
                            $('#isheadaddverify').prop('checked', false);
                            $("#isheadedit").attr("disabled", "disabled")
                            $("#isheadaddverify").attr("disabled", "disabled")
                        }

                        if (data.isheadupdate) {
                            // $("#islistupdateedit").attr("disabled", "disabled")
                            // $("#islistupdateverify").attr("disabled", "disabled")
                            // $("#islistedit").attr("disabled", "disabled")
                            // $("#islistaddverify").attr("disabled", "disabled")
                            $("#isheadupdateedit").removeAttr("disabled")
                            $("#isheadupdateverify").removeAttr("disabled")
                        }
                        else {
                            $('#isheadupdateedit').prop('checked', false);
                            $('#isheadupdateverify').prop('checked', false);
                            $("#isheadupdateedit").attr("disabled", "disabled")
                            $("#isheadupdateverify").attr("disabled", "disabled")
                        }

                        if (data.islist) {
                            // $("#isheadedit").attr("disabled", "disabled")
                            // $("#isheadaddverify").attr("disabled", "disabled")
                            // $("#isheadupdateedit").attr("disabled", "disabled")
                            // $("#isheadupdateverify").attr("disabled", "disabled")
                            $("#islistedit").removeAttr("disabled")
                            $("#islistaddverify").removeAttr("disabled")
                        }
                        else {
                            $('#islistedit').prop('checked', false);
                            $('#islistaddverify').prop('checked', false);
                            $("#islistedit").attr("disabled", "disabled")
                            $("#islistaddverify").attr("disabled", "disabled")
                        }

                        if (data.islistupdate) {
                            // $("#isheadupdateedit").attr("disabled", "disabled")
                            // $("#isheadupdateverify").attr("disabled", "disabled")
                            // $("#isheadedit").attr("disabled", "disabled")
                            // $("#isheadaddverify").attr("disabled", "disabled")
                            $("#islistupdateedit").removeAttr("disabled")
                            $("#islistupdateverify").removeAttr("disabled")
                        }
                        else {
                            $('#islistupdateedit').prop('checked', false);
                            $('#islistupdateverify').prop('checked', false);
                            $("#islistupdateedit").attr("disabled", "disabled")
                            $("#islistupdateverify").attr("disabled", "disabled")
                        }

                        //初始化数据
                        if (data.F_ReferType?.toString() != "-1") {
                            var datatype = data.F_ReferType == "0" || data.F_ReferType == "1" ? "5" : data.F_ReferType == "2" || data.F_ReferType == "3" ? "4" : "7"
                            // 获取选中的数据
                            $("#dataname").bindSelect({
                                url: "/SystemManage/Moduledata/GetReferenceListJson?F_DataType=" + datatype + "&F_ModuleId=" + currentModule,
                                id: "F_EnCode",
                                text: "F_DataName"
                            });
                            form.render();
                        }

                        // 设置列宽输入框的显示和赋值
                        if (data.formwidth == "1") { // 固定-显示
                            $("#width").removeClass("hiddlen").val(data.width);
                            $("#minWidth,#maxWidth").addClass("hiddlen");
                        } else if (data.formwidth == "2") { // 范围
                            $("#minWidth,#maxWidth").removeClass("hiddlen");
                            $("#minWidth").val(data.minWidth);
                            $("#maxWidth").val(data.maxWidth);
                            $("#width").addClass("hiddlen");
                        } else { // 自动
                            $("#width,#minWidth,#maxWidth").addClass("hiddlen");
                        }
                        if (!['decimal', 'float'].includes(model["datatype"])) {
                            $("#digits").attr("disabled", "disabled")
                            $("#lbl_DecimalDigits").removeClass("required");
                            $("#digits").removeAttr("lay-verify");
                        }
                        // 模板里的默认值不一定在固定五项里，先补成选项再赋值
                        ensureDefaultOption(data["default"]);
                        common.val('adminform', data);
                        // 打开已有字段时，默认值框按类型恢复输入限制
                        applyDefaultInputMode($("#datatype").val());
                        F_Id = data.F_Id;//由于F_Id的input框值会被参数字段selectTable覆盖，所以增加了一个全局变量F_Id
                        if (data.dataname !== "" && data.dataname !== null) {
                            common.ajax({
                                type: "Get",
                                url: '/SystemManage/ModuleData/GetFormByCodeJson?F_EnCode=' + data.dataname,
                                async: false,
                                success: function (res) {
                                    if (res != null && res.length > 0 && res[0].F_ObjectName != undefined) {
                                        $("#TableName").val(res[0].F_ObjectName)
                                        // 按模块 F_Rename 将 cross 中的旧字段名替换为新字段名
                                        var renameList = (res[0].F_Rename || '').split(',').filter(Boolean);
                                        if (renameList.length) {
                                            var crossArr = ($('#cross').val() || '').split(',');
                                            var mapped = crossArr.map(function (n) {
                                                n = (n || '').trim();
                                                if (!n) return n;
                                                for (var i = 0; i < renameList.length; i++) {
                                                    var parts = renameList[i].split('|');
                                                    if (parts[1] && parts[1] === n) return parts[0] || n;
                                                }
                                                return n;
                                            });
                                            recross = mapped.join(',');
                                        }
                                        bindFields(res[0].F_ObjectName)
                                    }
                                }
                            })
                        }
                    }
                });
            }
            else {
                $("#F_EnabledMark").prop("checked", true);//默认有效选中
                $("#filter").prop("checked", true);//默认搜索启用
            }
            if (isMainTableField) {
                //主表字段：表体、参照区块隐藏；选项只保留 公共/有效 可点，其余禁用并清空
                $(".js-main-hide").addClass("hiddlen");
                $("#order,#filter,#F_IsMerge,#F_IsTotal,#subtotal,#ignore")
                    .prop("disabled", true).prop("checked", false);
            }
            form.render();
            common.ajax({
                url: '/SystemManage/ModuleFields/GetModuleTableListJson',
                dataType: 'json',
                data: { encode: tableid },
                async: false,
                success: function (result) {
                    var DbObjectKind = result[0].DbObjectKind.trim();
                    if (DbObjectKind == "Table")//如果是表
                        $("#F_IsTable").val(true);
                }
            });
            $("#F_TableName").val(tableid);

            // 初始隐藏所有 357-370区块
            $("#width").addClass("hiddlen");
            $("#minWidth").addClass("hiddlen");
            $("#maxWidth").addClass("hiddlen");
        });

        form.on('select(F_ReferType)', function (data) {
            $("#dataname").empty();
            // ★ 增加默认选项，避免数据为空时下拉框空白
            $("#dataname").append("<option value=''>请选择</option>");
            if (data.value) {
                var datatype = data.value == "0" || data.value == "1" ? "5" : data.value == "2" || data.value == "3" ? "4" : "7"
                // 获取选中的数据
                $("#dataname").bindSelect({
                    url: "/SystemManage/Moduledata/GetReferenceListJson?F_DataType=" + datatype + "&F_ModuleId=" + currentModule,
                    id: "F_EnCode",
                    text: "F_DataName"
                });
            }
            form.render('select');
        })

        form.on('select(dataname)', function (data) {
            // 获取选中的数据
            var str = data.value
            common.ajax({
                type: "Get",
                url: '/SystemManage/ModuleData/GetFormByCodeJson?F_EnCode=' + str,
                async: false,
                success: function (res) {
                    if (res != null && res.length > 0 && res[0].F_ObjectName != undefined) {
                        $("#params").val("")
                        $("#cross").val("")
                        $("#TableName").val(res[0].F_ObjectName)
                        bindFields(res[0].F_ObjectName)
                    }
                }
            })
        })

        window.selectdata = function () {
            if ($("#dataname").val() == "") {
                common.modalMsg("请先选择数据", "warning");
                return false;
            }
        }

        //绑定参数数据
        window.bindFields = async function (tableName) {
            const selected = await common.getMyFieldData({
                enCode: 'GetObjectFields',
                fieldData: { F_EnCode: $('#params').val().split(',').map((i) => i.trim()) },
                params: { TableName: $("#TableName").val(), keyword: "" },
                myFields: 'F_Id'
            });
            const selected2 = await common.getMyFieldData({
                enCode: 'GetObjectFields',
                fieldData: { F_EnCode: recross.split(',').map((i) => i.trim()) },
                params: { TableName: $("#TableName").val(), keyword: "" },
                myFields: 'F_Id'
            });
            tableSelect.render({
                elem: '#params',
                checkedKey: 'F_Id',
                searchKey: 'keyword',
                searchPlaceholder: '关键词搜索',
                height: '200',
                sameApi: false,
                selected,
                table: {
                    url: `/Public/GetReferenceListJson?enCode=GetObjectFields`,
                    params: {
                        TableName: ""
                    },
                    cols: [[{ type: 'checkbox', fixed: 'left' },
                    { field: 'F_Id', title: '', hide: true },
                    { field: 'F_EnCode', title: '字段' },
                    { field: 'F_FullName', title: '名称' }
                    ]]
                },
                done: function (elem, checkStatus) {
                    // 显示名称
                    var text = checkStatus.data.map(item => item.F_EnCode).join(',');
                    $(elem).val(text.trim());
                }
            });
            tableSelect.render({
                elem: '#cross',
                checkedKey: 'F_Id',
                searchKey: 'keyword',
                searchPlaceholder: '关键词搜索',
                height: '200',
                sameApi: false,
                selected: selected2,
                table: {
                    url: `/SystemManage/ModuleFields/GetColsJson?enCode=` + $("#dataname").val(),
                    cols: [[{ type: 'checkbox', fixed: 'left' },
                    { field: 'F_Id', title: '', hide: true },
                    { field: 'F_EnCode', title: '字段' },
                    { field: 'F_FullName', title: '名称' }
                    ]]
                },
                done: function (elem, checkStatus) {
                    // 显示名称
                    var text = checkStatus.data.map(item => item.F_EnCode).join(',');
                    $(elem).val(text.trim());
                }
            });
        }


        //==============================================================
        // 默认值：原生 layui 下拉（lay-search 可搜索）
        // 五个固定项之外，手输的内容最多再留一条“自定义项”；改内容时删旧加新
        //==============================================================
        var defaultPickedInList = false; // 搜索过程中点了下拉里的项（含“请选择”），本次要落地的手输内容作废
        var defaultPendingText = "";     // 最新敲进去、还没落地的内容；layui 关闭下拉时会把搜索框改回选中项文本，所以单独记一份

        // 当前选中项的文本。占位项（value 为空）按空串算
        function defaultSelectedText() {
            var $opt = $("#default").find("option:selected");
            return $opt.length && $opt.val() ? $.trim($opt.text()) : "";
        }

        function defaultInputMode() {
            return $("#default").attr("data-numeric") || "";
        }

        // int 只留整数，decimal 只留一个小数点（都允许开头的负号），其他类型原样返回
        function sanitizeDefaultText(text) {
            text = text == null ? "" : String(text);
            var mode = defaultInputMode();
            if (!mode) return text;
            var negative = text.charAt(0) === '-';
            var body = negative ? text.slice(1) : text;
            if (mode === 'decimal') {
                var dot = body.indexOf('.');
                body = dot < 0
                    ? body.replace(/\D/g, '')
                    : body.slice(0, dot).replace(/\D/g, '') + '.' + body.slice(dot + 1).replace(/\D/g, '');
            }
            else {
                body = body.replace(/\D/g, '');
            }
            return negative ? '-' + body : body;
        }

        // 只有一个负号或小数点不算值
        function isUsableDefaultText(text) {
            if (!defaultInputMode()) return !!text;
            return !!text && text !== '-' && text !== '.' && text !== '-.';
        }

        // 打开已有字段时，模板里的默认值可能不在固定五项里，先补成选项，否则下拉会显示空白
        function ensureDefaultOption(value) {
            var text = $.trim(value == null ? "" : String(value));
            if (!text) return;
            var $select = $("#default");
            var exists = false;
            $select.find("option").each(function () {
                if ($.trim(this.value) === text) { exists = true; return false; }
            });
            if (exists) return;
            $select.find('option[data-custom="1"]').remove();
            $select.append($('<option data-custom="1"></option>').val(text).text(text));
        }

        // 失焦后落地：内容等于已有项就直接选中它，否则替换掉上一条自定义项
        function commitDefaultText(typed) {
            var $select = $("#default");
            var text = sanitizeDefaultText($.trim(typed || ""));
            defaultPendingText = "";
            // 搜索过程中点了已有项/“请选择”，layui 已把输入框改写成选中项，这次不算手输。
            // 标记只用一次：点完之后再改输入框会触发 input 重新记 pending，那时就应该正常落地
            if (defaultPickedInList) {
                defaultPickedInList = false;
                return;
            }
            if (!text) return;
            var matched = null;
            $select.find("option").each(function () {
                // 固定项的 value 是 {loginUser} 这类模板变量，手输的往往是它的文本，value/text 都要认
                var val = $.trim(this.value), txt = $.trim($(this).text());
                if (val && (val === text || txt === text)) { matched = this; return false; }
            });
            if (matched) {
                if ($select.val() !== matched.value) {
                    $select.val(matched.value);
                    form.render("select");
                }
                return;
            }
            if (!isUsableDefaultText(text)) {
                form.render("select");
                return;
            }
            $select.find('option[data-custom="1"]').remove();
            $select.append($('<option data-custom="1"></option>').val(text).text(text));
            $select.val(text);
            form.render("select");
        }

        // layui 渲染出来的搜索框
        function defaultSearchInput() {
            return $("#default").parent().find(".layui-form-select input.layui-input").first();
        }

        // 提交前兜底：搜索框里还有没落地的输入就直接写进 select。
        // 失焦后补选项是延后 220ms 执行的，点提交时根本来不及，只能在这里同步补一次
        function flushDefaultText() {
            // 最后一次操作是点下拉里的项（含“请选择”），输入框里只剩选中项文本，没有要落地的手输内容
            if (defaultPickedInList) {
                defaultPickedInList = false;
                defaultPendingText = "";
                return;
            }
            var $input = defaultSearchInput();
            // 优先用输入时记下的内容：失焦后 layui 会把搜索框改回选中项文本，那时 val() 已经不可信
            var typed = $.trim(defaultPendingText);
            if (!typed) typed = $.trim($input.length ? $input.val() : "");
            if (!typed) return;
            // 和当前选中项一致，说明没有新输入
            if (typed === defaultSelectedText()) return;
            commitDefaultText(typed);
        }

        // 按当前数据类型给默认值框设定输入模式。int 只能整数，decimal 可带小数，其余不限
        function applyDefaultInputMode(datatype) {
            var mode = datatype === 'decimal' ? 'decimal' : (datatype === 'int' ? 'int' : '');
            $("#default").attr("data-numeric", mode);
            if (!mode) return;
            // 类型改成数字型后，已经选中的非数字值清掉
            var text = defaultSelectedText();
            if (text && sanitizeDefaultText(text) !== text) {
                $("#default").val("");
                form.render("select");
            }
        }

        // 脚本在 body 之前，绑定要等 DOM 就绪。layui 下拉会随 form.render 重建，事件挂在父容器上做委托
        $(function () {
            var $wrap = $("#default").parent();
            // 数字类型边打边过滤搜索内容，同时记下这份“还没落地”的内容。
            // 出现 input 说明用户在打字，之前“点过下拉项”的标记要清掉，改完之后的内容才会落地
            $wrap.on("input", ".layui-form-select input.layui-input", function () {
                var next = sanitizeDefaultText(this.value);
                if (next !== this.value) this.value = next;
                defaultPendingText = $.trim(this.value);
                defaultPickedInList = false;
            });
            // 直接点选已有项 / 点“请选择”时，之前手输的内容作废（选中项以 layui 写的为准）
            form.on('select(defaultValue)', function () {
                defaultPickedInList = true;
                defaultPendingText = "";
            });
            // 失焦时把搜不到的内容补成选项。延后一点，让“点选已有项”先走完
            $wrap.on("blur", ".layui-form-select input.layui-input", function () {
                var typed = this.value || defaultPendingText;
                if (!typed) return;
                setTimeout(function () { commitDefaultText(typed); }, 220);
            });
        });

        window.reloadfields = function (datatype) {
            if (['nvarchar', 'varchar', 'char'].includes(datatype)) {
                $("#Length").removeClass("hiddlen");
            } else {
                $("#Length").addClass("hiddlen");
            }
            if (['decimal', 'float'].includes(datatype)) {
                $("#digits").removeAttr("disabled");
                $("#lbl_DecimalDigits").addClass("required");
                $("#digits").attr("lay-verify", "required");
            } else {
                $("#digits").attr("disabled", "disabled")
                $("#lbl_DecimalDigits").removeClass("required");
                $("#digits").removeAttr("lay-verify");
            }
            applyDefaultInputMode(datatype);
            form.render();
        }

        form.on('select(datatype)', function (data) {
            reloadfields(data.value);
        })

        tableSelect.render({
            elem: '#btn_SysTable',
            checkedKey: 'F_EnCode',
            searchKey: 'keyword',
            searchPlaceholder: '关键词搜索',
            width: '600px',
            sameApi: false,
            table: {
                url: `/SystemManage/ModuleFields/GetSysObjectListJson?objectname=${tableid}`,
                cols: [[{ type: 'radio', fixed: 'left' },
                { field: 'F_EnCode', title: '名称', width: 100 },
                { field: 'F_FullName', title: '说明', width: 100 },
                { field: 'F_DataType', title: '类型', width: 100 },
                { field: 'F_Length', title: '长度' },
                { field: 'F_DecimalDigits', title: '小数' },
                { field: 'F_IsNullable', title: '可空' },
                { field: 'F_IsIdentity', title: '自增' },
                { field: 'F_DefaultValue', title: '默认' },
                { field: 'F_ParamMode', title: '参数' }
                ]]
            },
            done: function (elem, checkStatus) {
                //选中后执行
                var data = checkStatus.data[0];
