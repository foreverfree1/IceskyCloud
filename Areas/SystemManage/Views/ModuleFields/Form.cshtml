        // ★ 悬停提示统一处理：所有带 data-tips 的控件，提示词同步到自身及 layui 渲染容器（select/checkbox 原生元素被隐藏）
        var bindTips = function () {
            $('[data-tips]').not(':checkbox').each(function () {
                var tips = $(this).data('tips');
                if (!tips) return;
                // 原生控件本身：普通 input 直接可见，title 原生生效
                $(this).attr('title', tips);
                // layui 渲染容器：select → div.layui-form-select，checkbox → div.layui-form-checkbox
                $(this).siblings('.layui-form-select').attr('title', tips);
            });
        };
        // form.render() 会重建 layui 渲染容器，对每个带 data-tips 控件的父容器注册监听（同一父容器只注册一次）
        $('[data-tips]').not(':checkbox').parent().each(function () {
            if (!$(this).data('tipsObserved')) {
                $(this).data('tipsObserved', true);
                new MutationObserver(bindTips).observe(this, { childList: true, subtree: true });
            }
        });
        bindTips();

        // ★ 小计复选框悬停提示：layui 渲染后原生 input 被隐藏，需将提示词同步到自绘容器 div.layui-form-checkbox
        var bindCheckboxTips = function () {
            var subtips = $('#subtotal').data('tips');
            var mergetips = $('#F_IsMerge').data('tips');
            var totaltips = $('#F_IsTotal').data('tips');
            var ignoretips = $('#ignore').data('tips');
            var filtertips = $('#filter').data('tips');
            if (subtips) {
                $('#subtotal').next('.layui-form-checkbox').attr('title', subtips);
            }
            if (mergetips) {
                $('#F_IsMerge').next('.layui-form-checkbox').attr('title', mergetips);
            }
            if (totaltips) {
                $('#F_IsTotal').next('.layui-form-checkbox').attr('title', totaltips);
            }
            if (ignoretips) {
                $('#ignore').next('.layui-form-checkbox').attr('title', ignoretips);
            }
            if (filtertips) {
                $('#filter').next('.layui-form-checkbox').attr('title', filtertips);
            }
        };
        // form.render() 会重建渲染容器（页面多处调用），用 MutationObserver 监听父容器保证每次渲染后提示词仍然生效
        new MutationObserver(bindCheckboxTips).observe($('#subtotal').parent()[0], { childList: true, subtree: true });
        new MutationObserver(bindCheckboxTips).observe($('#F_IsMerge').parent()[0], { childList: true, subtree: true });
        new MutationObserver(bindCheckboxTips).observe($('#F_IsTotal').parent()[0], { childList: true, subtree: true });
        new MutationObserver(bindCheckboxTips).observe($('#ignore').parent()[0], { childList: true, subtree: true });
        new MutationObserver(bindCheckboxTips).observe($('#filter').parent()[0], { childList: true, subtree: true });
        bindCheckboxTips();


        // 页面初始时默认触发一次，以设置窗口
        $(function () {
            var initialFormWidth = $("#formwidth").val();
            handleFormWidthSelect(initialFormWidth);
        });

        //监听提交
        form.on('submit(saveBtn)', function (data) {
            // data.field 是点击瞬间取的，搜索框里刚输的内容还没进 select，先落地再取一次值
            flushDefaultText();
            var postData = data.field;
            postData["default"] = $("#default").val();
            ['F_IsPublic', 'F_IsTotal', 'F_IsMerge', 'F_EnabledMark', 'order', 'filter', 'subtotal', 'ignore',
                'islist', 'islistedit', 'islistaddverify', 'islistupdate', 'islistupdateedit', 'islistupdateverify',
                'ishead', 'isheadedit', 'isheadaddverify', 'isheadupdate', 'isheadupdateedit', 'isheadupdateverify'
            ].forEach(function (k) {
                postData[k] = !!postData[k];
            });

            var json = {
                formwidth: postData["formwidth"],
                width: postData["width"],
                minWidth: postData["minWidth"],
                maxWidth: postData["maxWidth"],
                filter: postData["filter"],
                subtotal: postData["subtotal"],
                ignore: postData["ignore"],
                order: postData["order"],
                fixed: postData["fixed"],
                templet: postData["templet"],
                align: postData["align"],
                modulename: postData["modulename"],
                dataname: postData["dataname"],
                islist: postData["islist"],
                islistedit: postData["islistedit"],
                islistaddverify: postData["islistaddverify"],
                islistupdate: postData["islistupdate"],
                islistupdateedit: postData["islistupdateedit"],
                islistupdateverify: postData["islistupdateverify"],
                ishead: postData["ishead"],
                isheadedit: postData["isheadedit"],
                isheadaddverify: postData["isheadaddverify"],
                isheadupdate: postData["isheadupdate"],
                isheadupdateedit: postData["isheadupdateedit"],
                isheadupdateverify: postData["isheadupdateverify"],
                coltitle: postData["coltitle"],
                params: postData["params"],
                cross: postData["cross"],
                datatype: postData["datatype"],
                length: postData["length"],
                digits: postData["digits"],
                default: postData["default"],
                placeholder: postData["placeholder"],
                headwidth: postData["headwidth"]
            }
            postData.F_Template = JSON.stringify(json);
            postData["F_ModuleId"] = moduleId;
            common.submitForm({
                url: '/SystemManage/ModuleFields/SubmitForm?keyValue=' + F_Id,
                param: postData,
                success: function () {
                    common.parentreload('data-search-btn');
                }
            })
            return false;
        });

        // 回车键触发保存：仅作用于表单内的 input/select（textarea 仍可换行）
        $('.layuimini-form').on('keydown', 'input, select', function (e) {
            if (e.keyCode === 13 || e.which === 13) {
                e.preventDefault();
                $('#submit').trigger('click');
            }
        });
    });
</script>
