        // 列宽模式切换，自动不显示输入，固定显示宽度框，范围显示最小最大框
        // 在页面打开时默认执行一次
        function handleFormWidthSelect(value) {
            switch (value) {
                case '0': // 自动
                    $("#width").addClass("hiddlen");
                    $("#minWidth, #maxWidth").addClass("hiddlen");
                    break;
                case '1': // 固定
                    $("#widthContainer").removeClass("hiddlen");
                    $("#width").removeClass("hiddlen");
                    $("#minWidth, #maxWidth").addClass("hiddlen");
                    break;
                case '2': // 范围
                    $("#widthContainer").removeClass("hiddlen");
                    $("#width").addClass("hiddlen");
                    $("#minWidth, #maxWidth").removeClass("hiddlen");
                    break;
            }
        }

