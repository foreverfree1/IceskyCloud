                $('#F_IsTotal').prop('checked', false);
            }
            else if (!hasMergeField && !data.elem.checked) {
                $('#subtotal').prop('disabled', true);
            }
            else if (hasMergeField && data.elem.checked) {
                $('#F_IsTotal').prop('checked', false);
            }
            form.render('checkbox');
        });

